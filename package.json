{
  "name": "movie-recorder-upload",
  "version": "2.0.0",
  "description": "A macOS local server that uploads Softron MovieRecorder gangs to Descript.",
  "author": "Movie Recorder Upload",
  "type": "module",
  "bin": { "movie-recorder-upload": "dist-server/main/main.js" },
  "engines": { "node": ">=24" },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:server": "tsc -p tsconfig.main.json && esbuild dist-server/main/main.js --bundle --platform=node --format=cjs --target=node24 --outfile=build/movie-recorder-upload.cjs",
    "build:web": "vite build",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:sea": "npm run build && node scripts/build-sea.mjs",
    "dev": "npm run build && node --watch dist-server/main/main.js --data-dir .local-data --open",
    "start": "node dist-server/main/main.js",
    "test-local": "npm run clean && tsc -p tsconfig.main.json && vite build && node --test tests/*.test.mjs",
    "test": "npm run test-local",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.8",
    "postcss": "^8.5.6",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}
